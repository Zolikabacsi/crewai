# .env.example — Office Assistant

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# ── Google Workspace (gws CLI) — credentials handled by gws itself ──────────
# Ensure `gws` is on your PATH (~/bin/gws or in .venv)

# ── Optional ───────────────────────────────────────────────────────────────
LOOKBACK_DAYS=30